{
  "manifest_version": 3,
  "name": "Boardmine",
  "version": "0.4.0",
  "description": "Turn your New Tab into an ambient live dashboard with auto-updating visual clips from any web page. 100% local, session-aware.",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs",
    "debugger",
    "scripting",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Boardmine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
